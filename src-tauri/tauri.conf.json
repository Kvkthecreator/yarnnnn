{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yarnnn",
  "version": "0.1.0",
  "identifier": "com.yarnnn.desktop",
  "build": {
    "beforeDevCommand": "node web/scripts/shell-next.mjs dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node web/scripts/shell-next.mjs build",
    "frontendDist": "../web/.next-shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Shared memory for AI + human work",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "yarnnn"
        ]
      }
    }
  }
}
