{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yarnnn",
  "version": "0.1.0",
  "identifier": "com.yarnnn.desktop",
  "build": {
    "beforeDevCommand": "cd web && YARNNN_SHELL=1 npx next dev -p 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd web && YARNNN_SHELL=1 NEXT_PUBLIC_API_URL=https://yarnnn-api.onrender.com npx next build",
    "frontendDist": "../web/.next-shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Shared memory for AI + human work",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "yarnnn"
        ]
      }
    }
  }
}
