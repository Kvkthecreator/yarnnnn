{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.2",
  "description": "__MSG_extDescription__",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "yarnnn",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://www.yarnnn.com/*",
      "https://yarnnn.com/*",
      "http://localhost:3000/*"
    ]
  },
  "default_locale": "en"
}
