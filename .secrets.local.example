# Copy this file to `.secrets.local` (gitignored) and paste the real connection
# string from Supabase → Project Settings → Database → Connection string (URI,
# transaction pooler, port 6543). The password must be URL-encoded.
#
# Once this exists, `scripts/db/run-migration.sh <file>` (and Claude Code) can
# apply migrations without the secret ever entering the tracked tree or chat.
export SUPABASE_DB_URL="postgresql://postgres.noxgqcwynkzqabljjyon:<URL_ENCODED_PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"
